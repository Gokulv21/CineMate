# Together Environment Configuration

# Server Port
PORT=4000

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:3000

# Client Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# Optional: Custom STUN/TURN servers (comma-separated URLs)
# Defaults to Google public STUN servers if left blank
VITE_STUN_URL=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
